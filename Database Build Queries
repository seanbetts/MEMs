//Database Build Queries

// Load Mems.csv
LOAD CSV WITH HEADERS FROM 'file:///Mems.csv' AS row
CALL apoc.create.node(['Mem'],{memID: toInteger(row.memID), mem: row.mem, date: date(row.date), memType: row.memType, emoji: row.emoji, pictures: (row.Pictures), notes: (row.Notes), personID: split(row.People,","), placeID: split(row.Place,",")})
YIELD node
RETURN node;

//Create memsID Constraint
CREATE CONSTRAINT memsID
ON (n:Mems)
ASSERT n.memsID IS UNIQUE;

// Load Person.csv
LOAD CSV WITH HEADERS FROM 'file:///Person.csv' AS row
