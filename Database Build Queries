// Mem - [WITH] -> Person
MATCH (m:Mem)
UNWIND m.personID as person
MERGE (p:Person{personID: TOINTEGER(person)})
MERGE (m)-[:WITH]->(p);

// Mem - [AT] -> Place
MATCH (m:Mem)
UNWIND m.placeID as place
MERGE (p:Place{placeID: TOINTEGER(place)})
MERGE (m)-[:AT]->(p);

// Mem - [LISTENED_TO] -> Music
MATCH (m1:Mem), (m2:Music)
WHERE m1.mem = m2.album AND m1.memType="Music"
CREATE (m1)-[r:LISTENED_TO]->(m2);

// Mem - [WATCHED] -> Movie
MATCH (m1:Mem), (m2:Movie)
WHERE m1.mem = m2.movie AND m1.memType="Movie"
CREATE (m1)-[r:WATCHED]->(m2);

// Mem - [WATCHED] -> TV Show
MATCH (m:Mem), (t:TVShow)
WHERE m.mem = t.tvshow AND m.memType="TVShow"
CREATE (m)-[r:WATCHED]->(t);

// Mem - [PLAYED] -> Game
MATCH (m:Mem), (g:Game)
WHERE m.mem = g.game AND m.memType="Game"
CREATE (m)-[r:PLAYED]->(g)